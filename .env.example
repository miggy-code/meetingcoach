# ─────────────────────────────────────────────────────────────
# Airtable Configuration
# ─────────────────────────────────────────────────────────────

# Personal Access Token — needs data.records:read, data.records:write, schema.bases:read
AIRTABLE_API_KEY=pat...

# ThrottlGTM base (outreach tables — Leads, Active Outreach, Archive, Companies)
# Kept for future GTM-facing routes. Not used by the Meeting Intelligence dashboard.
AIRTABLE_BASE_ID=appfS9ODVKZ2XEATW

# ThrottlInternal base (Meeting Notes, Goals Tracker, Projects)
# This is the primary base for the Meeting Intelligence dashboard.
AIRTABLE_INTERNAL_BASE_ID=appZBVnpJImiNvIHM

# Table IDs within ThrottlInternal
AIRTABLE_TABLE_MEETING_NOTES=tblLARyeD0D9Upk7r
AIRTABLE_TABLE_GOALS_TRACKER=tbl8X41pydHiwRMfh
AIRTABLE_TABLE_PROJECTS=tbl3kMc5aOkr4Fxjr
AIRTABLE_TABLE_OFFERS=tblTZalWdVFEIEAgI

# ─────────────────────────────────────────────────────────────
# AI Configuration
# ─────────────────────────────────────────────────────────────

# DeepSeek API key — used for meeting analysis and follow-up email generation
DEEPSEEK_API_KEY=...

# DeepSeek API base URL (default: https://api.deepseek.com)
DEEPSEEK_BASE_URL=https://api.deepseek.com

# DeepSeek model (deepseek-chat for standard; deepseek-reasoner for harder cases)
DEEPSEEK_MODEL=deepseek-chat

# ───────────────────────────────────────────────────────────────
# Fathom Webhook
# ───────────────────────────────────────────────────────────────

# Webhook secret from Fathom Settings > API Access > Add Webhook
# Format: whsec_...
# Endpoint to register in Fathom: https://your-domain.com/api/webhooks/fathom
FATHOM_WEBHOOK_SECRET=whsec_...
